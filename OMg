			end
			if light:IsA("MeshPart") and light.Material == Enum.Material.Neon and light.Name ~= "Skybox" then
				local target1 = {Color = color0}
				local anim2 = tweenservice:Create(light,info,target1)
				anim2:Play()
			end
		end
	end

