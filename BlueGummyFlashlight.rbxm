local player = game.Players.LocalPlayer

script.Parent.Activated:Connect(function()
	if script.Parent.Handle.SpotLight.Enabled == true then
		if script.Parent.Handle.SpotLight.Brightness <= 200 then
			script.Parent.Handle.SpotLight.Brightness = script.Parent.Handle.SpotLight.Brightness + 5
			script.Parent.Handle.Sound:Play()
		end
	end
end)
script.Parent.Equipped:Connect(function()
	script.Parent.Handle.SpotLight.Enabled = true
	script.Parent.Handle.SpotLight.LocalScript.Enabled = true
	script.Parent.Handle.equip:Play()
	player.PlayerGui.Energy.Enabled = true
end)
script.Parent.Unequipped:Connect(function()
	script.Parent.Handle.SpotLight.Enabled = false
	script.Parent.Handle.SpotLight.LocalScript.Enabled = false
	script.Parent.Handle.equip:Play()
	player.PlayerGui.Energy.Enabled = false
end)]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties><Item class="ObjectValue" referent="17"><Properties><Ref name="Value">16</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SaveChangesTo]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties></Item><Item class="LocalScript" referent="18"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

