--// ========================================== --
--//            DOORS PATHFINDING               --
--// ========================================== --
task.wait(SPAWN_DELAY)

local roomsFolder = workspace:WaitForChild("CurrentRooms")
local orderedRooms = {}

for _, room in ipairs(roomsFolder:GetChildren()) do
    local roomNum = tonumber(room.Name)
    if roomNum then
        table.insert(orderedRooms, {Number = roomNum, Instance = room})
    end
end
table.sort(orderedRooms, function(a, b) return a.Number < b.Number end)

if #orderedRooms == 0 then return end

local startingRoom = orderedRooms[1].Instance
local startPart = startingRoom:FindFirstChild("RoomStart") or (startingRoom:FindFirstChild("Parts") and startingRoom.Parts:FindFirstChild("Floor"))
if startPart then
    hrp.CFrame = startPart.CFrame + Vector3.new(0, 3.5, 0)
end

local targetPlayerRoomInstance = nil

for idx, roomData in ipairs(orderedRooms) do
    local roomObj = roomData.Instance
    
    if roomData.Number == latestRoomNum then
        targetPlayerRoomInstance = roomObj
    end
    
    if roomData.Number <= latestRoomNum then
        local targets = {}
        local rStart = roomObj:FindFirstChild("RoomStart")
        local rEnd = roomObj:FindFirstChild("RoomEnd") or (roomObj:FindFirstChild("Parts") and roomObj.Parts:FindFirstChild("Door"))
        
        if rStart then table.insert(targets, rStart) end
        if rEnd then table.insert(targets, rEnd) end
        
        if #targets == 0 and roomObj:FindFirstChild("Parts") and roomObj.Parts:FindFirstChild("Floor") then
            table.insert(targets, roomObj.Parts.Floor)
        end

        for _, point in ipairs(targets) do
            local targetCFrame = point.CFrame + Vector3.new(0, 3.5, 0)
            local distance = (hrp.Position - targetCFrame.Position).Magnitude
            
            if distance > 1 then
                local moveTween = TweenService:Create(
                    hrp,
                    TweenInfo.new(distance / ENTITY_SPEED, Enum.EasingStyle.Linear),
                    {CFrame = targetCFrame}
                )
                moveTween:Play()
                moveTween.Completed:Wait()
            end
        end
    end
end

--// ========================================== --
--//      IDLE 5 SECONDS WITH EXTREME SHAKE     --
--// ========================================== --
if targetPlayerRoomInstance then
    local finalDespawnPoint = targetPlayerRoomInstance:FindFirstChild("RoomEnd") 
        or (targetPlayerRoomInstance:FindFirstChild("Parts") and targetPlayerRoomInstance.Parts:FindFirstChild("Door"))
        or targetPlayerRoomInstance:FindFirstChild("RoomStart")
    
    if not finalDespawnPoint and targetPlayerRoomInstance:FindFirstChild("Parts") then
        finalDespawnPoint = targetPlayerRoomInstance.Parts:FindFirstChild("Floor")
    end
    
    if finalDespawnPoint then
        local finalCFrame = finalDespawnPoint.CFrame + Vector3.new(0, 3.5, 0)
        local endMoveTween = TweenService:Create(
            hrp, 
            TweenInfo.new((hrp.Position - finalCFrame.Position).Magnitude / ENTITY_SPEED, Enum.EasingStyle.Linear), 
            {CFrame = finalCFrame}
        )
        endMoveTween:Play()
        endMoveTween.Completed:Wait()

        -- Trigger the flag to force maximum camera shake during the idle freeze
        isIdling = true

        -- Holds standard idle position for exactly 5 seconds in silence while shaking violently
        task.wait(5.0)
    end
end

