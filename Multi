local function SelectRandomEntity(rng)
	local totalWeight = 0
	for _, entity in ipairs(entityChances) do
		totalWeight = totalWeight + entity.Chance
	end

	local roll = (rng and rng:NextNumber() or math.random()) * totalWeight
	local counter = 0

	for _, entity in ipairs(entityChances) do
		counter = counter + entity.Chance
		if roll <= counter then
			return entity.Name
		end
	end
	return entityChances[1].Name
end

