local function CreateButton(name, callback)
	local Button = Instance.new("TextButton")
	Button.Name = name .. "Btn"
	Button.Parent = AdminExclusiveEntities
	Button.BackgroundColor3 = Color3.fromRGB(35, 38, 43)
	Button.Size = UDim2.new(1, 0, 0, 52)
	Button.Font = Enum.Font.Oswald
	Button.Text = name:upper()
	Button.TextColor3 = Color3.fromRGB(240, 240, 240)
	Button.TextSize = 16
	Button.AutoButtonColor = false

	local UICorner = Instance.new("UICorner")
	UICorner.CornerRadius = UDim.new(0, 8)
	UICorner.Parent = Button

	Button.BorderColor3 = Color3.fromRGB(55, 60, 68)
	Button.BorderSizePixel = 1

	Button.MouseEnter:Connect(function()
		TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 50, 56)}):Play()
	end)
	Button.MouseLeave:Connect(function()
		TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 38, 43)}):Play()
	end)
	Button.MouseButton1Down:Connect(function()
		TweenService:Create(Button, TweenInfo.new(0.05), {Size = UDim2.new(0.98, 0, 0, 50)}):Play()
	end)
	Button.MouseButton1Up:Connect(function()
		TweenService:Create(Button, TweenInfo.new(0.05), {Size = UDim2.new(1, 0, 0, 52)}):Play()
	end)

	Button.MouseButton1Click:Connect(callback)
	return Button
end

