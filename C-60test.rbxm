local A2 = script.Parent.RushNew.Attachment.MonsterGui2
local TweenService = game:GetService("TweenService")
local prop_A1_1 = {
	StudsOffsetWorldSpace = Vector3.new(-13, 5, 0)
}
local prop_A1_2 = {
	StudsOffsetWorldSpace = Vector3.new(13, 1.5, 0)
}
local prop_A1_3 = {
	StudsOffsetWorldSpace = Vector3.new(-13, 5, 0)
}
local prop_A2_1 = {
	StudsOffsetWorldSpace = Vector3.new(13, 1.5, 0)
}
local prop_A2_2 = {
	StudsOffsetWorldSpace = Vector3.new(-13, 5, 0)
}
local prop_A2_3 = {
	StudsOffsetWorldSpace = Vector3.new(-13, 1.5, 0)
}
local Info = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
while true do
	TweenService:Create(A1, Info, prop_A1_1):Play()
	TweenService:Create(A2, Info, prop_A2_1):Play()
	wait(2)
	TweenService:Create(A1, Info, prop_A1_2):Play()
	TweenService:Create(A2, Info, prop_A2_2):Play()
	wait(2)
	TweenService:Create(A1, Info, prop_A1_3):Play()
	TweenService:Create(A2, Info, prop_A2_3):Play()
end]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties><Item class="ObjectValue" referent="41"><Properties><Ref name="Value">40</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SaveChangesTo]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties></Item><Item class="LocalScript" referent="42"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

