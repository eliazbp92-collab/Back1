task.spawn(function()
	while death and task.wait(0.1) do
		if entity and entity.Parent and Character and Character.Parent then
			local currentHrp = Character:FindFirstChild("HumanoidRootPart")
			local hum = Character:FindFirstChildOfClass("Humanoid")

			if currentHrp and hum and hum.Health > 0 then
				local distance = (currentHrp.Position - entity.Position).Magnitude

				-- Kiểm tra khoảng cách va chạm (6 stud)
				if distance <= 6 then
					if not Character:GetAttribute("Hiding") then
						if not attacking then
							attacking = true
							hum:TakeDamage(0)

							PlayJumpscare1()

							if hum.Health <= 0 then
								local stats = ReplicatedStorage:FindFirstChild("GameStats")
								if stats then
									local playerStats = stats:FindFirstChild("Player_" .. player.Name)
									if playerStats and playerStats:FindFirstChild("Total") and playerStats.Total:FindFirstChild("DeathCause") then
										playerStats.Total.DeathCause.Value = "Deer Lord"
									end
								end
							end

							cleanup()
							task.wait(2)
							attacking = false
							break
						end
					end
				end
			end
		end
	end
end)

